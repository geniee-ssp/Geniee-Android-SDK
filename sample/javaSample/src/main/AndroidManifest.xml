<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="com.google.android.providers.gsf.permission.READ_GSERVICES" />

    <application
        android:name=".SampleApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/AppTheme">
        <meta-data
            android:name="com.google.android.gms.version"
            android:value="@integer/google_play_services_version" />
        <meta-data
            android:name="jp.co.geniee.gnadsdk.common.gnadlogger.priority"
            android:value="INFO" />

        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!--GNAd-->
        <activity
            android:name=".geniee.MenuActivity"
            android:exported="false"
            android:label="@string/title_activity_geniee_sdk"
            android:parentActivityName=".MainActivity"/>

        <!--Banner ads-->
        <activity
            android:name=".geniee.banner.BannerMenuActivity"
            android:exported="false"
            android:parentActivityName=".geniee.MenuActivity" />
        <activity
            android:name=".geniee.banner.SingleBannerDemoActivity"
            android:exported="false"
            android:label="@string/title_activity_single_banner"
            android:parentActivityName=".geniee.MenuActivity" />
        <activity
            android:name=".geniee.banner.MultipleBannerDemoActivity"
            android:exported="false"
            android:label="@string/title_activity_multiple_banner"
            android:parentActivityName=".geniee.banner.BannerMenuActivity" />
        <activity
            android:name=".geniee.banner.XmlBannerDemoActivity"
            android:exported="false"
            android:label="@string/title_activity_xml_banner"
            android:parentActivityName=".geniee.banner.BannerMenuActivity" />

        <!--Native Ads-->
        <activity
            android:name=".geniee.nativead.NativeAdMenuActivity"
            android:exported="false"
            android:parentActivityName=".geniee.MenuActivity" />
        <activity
            android:name=".geniee.nativead.NativeDemoActivity"
            android:label="@string/title_activity_native_ad"
            android:parentActivityName=".geniee.nativead.NativeAdMenuActivity" />
        <activity
            android:name=".geniee.nativead.NativeSimpleVideoDemoActivity"
            android:configChanges="orientation|screenSize"
            android:label="@string/title_activity_native_simple_video"
            android:parentActivityName=".geniee.nativead.NativeAdMenuActivity" />
        <activity
            android:name=".geniee.nativead.NativeVideoDemoActivity"
            android:exported="false"
            android:label="@string/title_activity_native_video"
            android:parentActivityName=".geniee.nativead.NativeAdMenuActivity" />

        <!--Interstitial Ads-->
        <activity
            android:name=".geniee.interstitial.InterstitialDemoActivity"
            android:exported="false"
            android:label="@string/title_activity_interstitial"
            android:parentActivityName=".geniee.MenuActivity" />

        <!--Vast Ads-->
        <activity
            android:name=".geniee.vast.VastDemoActivity"
            android:exported="false"
            android:label="@string/title_activity_vast"
            android:parentActivityName=".geniee.MenuActivity" />

        <!--Fullscreen Interstitial-->
        <activity
            android:name=".geniee.interstitial.FullscreenInterstitialActivity"
            android:exported="true"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:parentActivityName=".geniee.MenuActivity" />

        <!--Reward Video-->
        <activity
            android:name=".geniee.reward.RewardVideoActivity"
            android:exported="true"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:parentActivityName=".geniee.MenuActivity" />

        <!--Video Player-->
        <activity
            android:name=".geniee.videoplayer.GNAdSampleVideoPlayer"
            android:exported="true"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".geniee.videoplayer.GNAdSampleVideoPlayerLoadShow"
            android:configChanges="orientation|screenSize|screenLayout"
            android:parentActivityName=".geniee.videoplayer.GNAdSampleVideoPlayer">
        </activity>

        <!--Google Mediation-->
        <activity
            android:name=".googlemediation.MenuActivity"
            android:exported="false"
            android:label="@string/title_activity_google_mediation"
            android:parentActivityName=".MainActivity"/>
        <activity
            android:name=".googlemediation.BannerActivity"
            android:exported="false"
            android:parentActivityName=".googlemediation.MenuActivity"/>
        <activity
            android:name=".googlemediation.FullscreenInterstitialActivity"
            android:exported="false"
            android:parentActivityName=".googlemediation.MenuActivity"/>
        <activity
            android:name=".googlemediation.RewardActivity"
            android:exported="false"
            android:parentActivityName=".googlemediation.MenuActivity"/>

        <!--AppLovin MAX Mediation-->
        <activity
            android:name=".maxmediation.MenuActivity"
            android:exported="false"
            android:label="@string/title_activity_max_mediation"
            android:parentActivityName=".MainActivity"/>
        <activity
            android:name=".maxmediation.BannerActivity"
            android:exported="false"
            android:parentActivityName=".maxmediation.MenuActivity"/>
        <activity
            android:name=".maxmediation.InterstitialActivity"
            android:exported="false"
            android:parentActivityName=".maxmediation.MenuActivity"/>
        <activity
            android:name=".maxmediation.RewardedActivity"
            android:exported="false"
            android:parentActivityName=".maxmediation.MenuActivity"/>

        <activity android:name="com.mopub.mobileads.MoPubActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"/>
        <activity android:name="com.mopub.mobileads.MraidActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"/>
        <activity android:name="com.mopub.common.MoPubBrowser"
            android:configChanges="keyboardHidden|orientation|screenSize"/>
        <activity android:name="com.mopub.mobileads.MraidVideoPlayerActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"/>
        <activity android:name="com.mopub.mobileads.RewardedMraidActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"/>


    </application>

</manifest>
