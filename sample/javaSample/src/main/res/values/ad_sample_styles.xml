<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shared ad sample screen -->
    <style name="AdSample" />

    <style name="AdSample.Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="cardBackgroundColor">@color/ad_sample_surface</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">1dp</item>
        <item name="contentPadding">16dp</item>
    </style>

    <style name="AdSample.SectionTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">@color/ad_sample_text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="AdSample.InfoRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="AdSample.InfoLabel">
        <item name="android:layout_width">96dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/ad_sample_text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="AdSample.InfoValue">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:text">-</item>
        <item name="android:textColor">@color/ad_sample_text_primary</item>
        <item name="android:textIsSelectable">true</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="AdSample.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="AdSample.Button.Primary">
        <item name="android:background">@drawable/ad_sample_bg_button_primary</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

    <style name="AdSample.Button.Secondary">
        <item name="android:background">@drawable/ad_sample_bg_button_secondary</item>
        <item name="android:textColor">@color/ad_sample_button_secondary_text</item>
    </style>

    <style name="AdSample.TextAction">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:padding">2dp</item>
        <item name="android:textColor">@color/ad_sample_primary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="AdSample.OptionRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:textColor">@color/ad_sample_text_primary</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
